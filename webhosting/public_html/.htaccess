# ── ViralClips Studio — Hostinger shared hosting (LiteSpeed/Apache) ────────

# ffmpeg.wasm (multithreaded core) only gets SharedArrayBuffer on
# cross-origin-isolated pages. The encoder is currently pinned to a single
# thread (media.js — the MT build deadlocks on worker threads in some
# browsers), but the isolation headers stay: they cost nothing here (every
# subresource is same-origin, thumbnails and YouTube bytes arrive through our
# own /api proxies) and keep the door open for multithreading later.
<IfModule mod_headers.c>
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Embedder-Policy "require-corp"
  Header always set X-Content-Type-Options "nosniff"
</IfModule>

# ── never serve dotfiles, source or state ─────────────────────────────────
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Job state and uploaded clips must not be reachable by direct URL guess
# (they are served through api/serve.php with validation instead).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^data/ - [R=404,L]
  RewriteRule \.(env|md|log|json)$ - [R=404,L]
  # Deployment archives are uploaded into public_html before extraction —
  # they must never be downloadable, because they bundle the .env.
  # Exception: the precompressed encoder core under /assets/ffmpeg/ is a
  # normal static file the page downloads on purpose.
  RewriteCond %{REQUEST_URI} !^/assets/ffmpeg/
  RewriteRule \.(zip|tar|gz|tgz|7z|rar|sql|bak)$ - [R=404,L]
</IfModule>

# ── static asset caching ──────────────────────────────────────────────────
# JS/CSS/HTML are revalidated on every load: a deploy must never leave a
# visitor running week-old application code (a fresh 304 costs one round-trip).
<IfModule mod_headers.c>
  <FilesMatch "\.(js|mjs|css|html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # The ffmpeg core is a 33 MB wasm — every re-download costs the visitor
  # minutes on a slow link. Keep it for 30 days; when the core itself is
  # replaced, the code bumps the ?v= query so a fresh copy is fetched.
  <FilesMatch "\.wasm(\.gz)?$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/svg+xml "access plus 1 week"
</IfModule>

# LiteSpeed serves .wasm as text/plain by default, which disables both the
# expiry rules above and response compression. With the real type the 33 MB
# encoder core compresses to ~10 MB (about a third of the wait on slow links).
AddType application/wasm .wasm
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/wasm application/javascript text/javascript text/css text/html application/json image/svg+xml
</IfModule>

# Larger JSON payloads (AI vision batches) need room on the way in.
<IfModule mod_php.c>
  php_value post_max_size 64M
  php_value upload_max_filesize 64M
  php_value max_execution_time 300
  php_value max_input_time 300
  php_value memory_limit 512M
</IfModule>

DirectoryIndex index.html
Options -Indexes
